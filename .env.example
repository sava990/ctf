# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon public" key (atau publishable key sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (atau secret key sb_secret_...). RAHASIA — jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Opsional
# Domain email sintetis untuk akun (login tetap pakai nama).
AUTH_EMAIL_DOMAIN=ctf.local
# Zona waktu untuk tampilan & input jadwal.
NEXT_PUBLIC_TIME_ZONE=Asia/Jakarta
